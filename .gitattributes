# Preserve source-record bytes and empty trailing TSV fields. These are
# scientific input/audit artifacts, not whitespace-cleaned code exports.
study/environment/*.txt -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
study/examples/*.tsv -text whitespace=-blank-at-eol,cr-at-eol
study/tables/*.tsv -text whitespace=-blank-at-eol,cr-at-eol
study/native/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
study/configuration/** -text whitespace=-blank-at-eol,-blank-at-eof,cr-at-eol
